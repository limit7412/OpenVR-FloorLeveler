<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FloorLeveler.App.ViewModels"
        xmlns:svc="clr-namespace:FloorLeveler.App.Services"
        xmlns:ctl="clr-namespace:FloorLeveler.App.Controls"
        x:Class="FloorLeveler.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="720" Height="900"
        MinWidth="560" MinHeight="640"
        Title="{Binding L.WindowTitle}">

  <!-- キーボードショートカット (仕様 §6): 適用=Ctrl+Enter、元に戻す=Ctrl+Z。
       記録=Space は入力部品 (チェックボックス等) の操作を奪わないようコードビハインドで扱う。 -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApplyCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
  </Window.KeyBindings>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">

      <!-- 接続状態バー (仕様 §6) -->
      <Border Background="#20808080" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Button Content="{Binding L.ConnectButton}" Command="{Binding ConnectCommand}" />
            <!-- 言語切替 (仕様 §6)。選択は設定に保存される (F-7)。 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding L.LanguageLabel}" VerticalAlignment="Center" />
              <RadioButton GroupName="language" Content="{Binding L.LanguageJapanese}"
                           IsChecked="{Binding IsJapanese}" />
              <RadioButton GroupName="language" Content="{Binding L.LanguageEnglish}"
                           IsChecked="{Binding IsEnglish}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- デバイス選択とサンプリング -->
      <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding L.SamplingHeader}" FontWeight="Bold" />
          <ComboBox ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:GatewayDevice">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="sampling" Content="{Binding L.SamplingModeManual}"
                         IsChecked="{Binding IsManualSamplingSelected}" />
            <RadioButton GroupName="sampling" Content="{Binding L.SamplingModeStillness}"
                         IsChecked="{Binding IsStillnessSampling}" />
            <RadioButton GroupName="sampling" Content="{Binding L.SamplingModeContinuous}"
                         IsChecked="{Binding IsContinuousSampling}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding L.RecordButton}" Command="{Binding RecordPointCommand}" ToolTip.Tip="Space" />
            <Button Content="{Binding L.ClearButton}" Command="{Binding ClearPointsCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PointCountText}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SpreadLabelText}" />
          </StackPanel>
          <TextBlock FontSize="11" Foreground="#A0808080" TextWrapping="Wrap"
                     IsVisible="{Binding IsSamplingRequired}"
                     Text="{Binding L.SamplingHint}" />
        </StackPanel>
      </Border>

      <!-- 推定結果 -->
      <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding L.EstimateHeader}" FontWeight="Bold" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L.TiltLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TiltText}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L.ResidualLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResidualText}" />
            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="{Binding L.UseRansacLabel}" IsChecked="{Binding UseRansac}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 点群 / 床面の可視化 (仕様 F-4) -->
      <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding L.PlotHeader}" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{Binding L.TopViewLabel}" FontSize="12" Foreground="#A0808080" />
              <ctl:FloorPlotControl Plot="{Binding TopPlot}" EqualAspect="True" Height="200"
                                    EmptyText="{Binding L.PlotNoSamples}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{Binding L.SideViewLabel}" FontSize="12" Foreground="#A0808080" />
              <ctl:FloorPlotControl Plot="{Binding SidePlot}" EqualAspect="False" Height="200"
                                    EmptyText="{Binding L.PlotNoSamples}" />
            </StackPanel>
          </Grid>
          <TextBlock FontSize="11" Foreground="#A0808080" TextWrapping="Wrap"
                     Text="{Binding L.PlotHint}" />
        </StackPanel>
      </Border>

      <!-- 補正 -->
      <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding L.CorrectionHeader}" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="mode" Content="{Binding L.ModeGravityAlign}"
                         IsChecked="{Binding !UseMeasuredFloorMode}" />
            <RadioButton GroupName="mode" Content="{Binding L.ModeMeasuredFloor}"
                         IsChecked="{Binding UseMeasuredFloorMode}" />
          </StackPanel>
          <TextBlock Text="{Binding CorrectionSummary}" TextWrapping="Wrap" />
          <CheckBox Content="{Binding L.LargeCorrectionAcknowledge}"
                    IsVisible="{Binding NeedsConfirmation}"
                    IsChecked="{Binding LargeCorrectionAcknowledged}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding L.PreviewButton}" Command="{Binding PreviewCommand}" />
            <Button Content="{Binding L.CancelPreviewButton}" Command="{Binding CancelPreviewCommand}" />
            <Button Content="{Binding L.ApplyButton}" Command="{Binding ApplyCommand}" ToolTip.Tip="Ctrl+Enter" />
            <Button Content="{Binding L.UndoButton}" Command="{Binding UndoCommand}" ToolTip.Tip="Ctrl+Z" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- バックアップ / 復元 (仕様 F-6) -->
      <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding L.BackupHeader}" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding L.BackupButton}" Command="{Binding BackupCommand}" />
            <Button Content="{Binding L.RestoreLatestButton}" Command="{Binding RestoreLatestCommand}" />
          </StackPanel>

          <!-- 任意時点への復元 (仕様 F-6) -->
          <TextBlock Text="{Binding L.RestoreAnyLabel}" FontSize="12" Foreground="#A0808080" />
          <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                   Height="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupListItem">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding L.RestoreSelectedButton}" Command="{Binding RestoreSelectedCommand}" />
            <Button Content="{Binding L.RefreshBackupsButton}" Command="{Binding RefreshBackupsCommand}" />
          </StackPanel>

          <TextBlock FontSize="11" Foreground="#A0808080" TextWrapping="Wrap"
                     Text="{Binding L.BackupHint}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</Window>
